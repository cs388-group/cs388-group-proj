<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/screen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹  Back"
            android:textColor="@color/navy"
            android:textSize="18sp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/stepLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="SETUP 1 OF 2"
            android:textColor="@color/muted_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- Title -->
        <TextView
            android:id="@+id/locationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="location."
            android:textColor="@color/navy"
            android:textSize="29sp"
            android:textStyle="bold" />

        <!-- Description -->
        <TextView
            android:id="@+id/locationSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Find the state and local decisions that affect your community."
            android:textColor="@color/body_text"
            android:textSize="14sp" />

        <!-- ZIP Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="ZIP CODE"
            android:textColor="@color/body_text"
            android:textStyle="bold"
            android:textSize="11sp" />

        <!-- ZIP Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/zipCodeInputLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxStrokeColor="@color/navy"
            app:endIconMode="clear_text">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/zipCodeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter ZIP code"
                android:inputType="number"
                android:maxLength="5"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Current Location -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/currentLocationButton"
            style="@style/Widget.Legisly.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="◎  Use my current location"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="GPS is optional. Your ZIP code helps identify your legislative district."
            android:textColor="@color/muted_text"
            android:textSize="11sp" />

        <!-- Save / Continue -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:text="Continue"
            android:textAllCaps="false"
            app:cornerRadius="9dp"
            app:backgroundTint="@color/navy" />

    </LinearLayout>

</ScrollView>
