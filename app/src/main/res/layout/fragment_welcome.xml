<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/screen_background">

    <LinearLayout
        android:paddingTop="28dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="LEGISLY"
                android:textColor="@color/navy"
                android:textStyle="bold"
                android:textSize="25sp"
                android:letterSpacing="0.08" />

        </LinearLayout>

        <Space

            android:layout_width="match_parent"
            android:layout_height="50dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YOUR COMMUNITY. YOUR GOVERNMENT."
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:textSize="10sp"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Know what's\nhappening."
            android:textColor="@color/navy"
            android:textSize="36sp"
            android:fontFamily="sans"
            android:lineSpacingExtra="1dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Understand legislation, and know how your representatives vote."
            android:textColor="@color/body_text"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <Space android:layout_width="match_parent" android:layout_height="30dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="◎  Local context, from your ZIP code"
            android:textColor="@color/body_text"
            android:textSize="13sp"
            android:paddingVertical="7dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▤  Bills explained "
            android:textColor="@color/body_text"
            android:textSize="13sp"
            android:paddingVertical="7dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="♧  Updates your feed"
            android:textColor="@color/body_text"
            android:textSize="13sp"
            android:paddingVertical="7dp" />

        <Space android:layout_width="match_parent" android:layout_height="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/getStartedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="➜   Continue"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="9dp"
            app:backgroundTint="@color/navy" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/loginButton"
                style="@style/Widget.Legisly.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Login" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/signUpButton"
                style="@style/Widget.Legisly.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Sign Up" />
        </LinearLayout>


    </LinearLayout>
</ScrollView>
