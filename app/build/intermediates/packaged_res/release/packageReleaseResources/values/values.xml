<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent">#B94C55</color>
    <color name="body_text">#536174</color>
    <color name="card_border">#E1E6ED</color>
    <color name="muted_text">#8994A3</color>
    <color name="navy">#172F50</color>
    <color name="screen_background">#F5F7FA</color>
    <color name="selection_fill">#E7EEF7</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">CivicPulse</string>
    <style name="Theme.Legisly" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorPrimaryVariant">@color/navy</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Widget.Legisly.OutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">8dp</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>